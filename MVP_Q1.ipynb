       "  \"content\": \"import sys, os, json\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-materials\\\"))\\nimport d3d_materials as mat\\nimport numpy as np\\nimport matplotlib\\nmatplotlib.use(\\\"Agg\\\")\\nimport matplotlib.pyplot as plt\\n\\nnames = [s[\\\"name\\\"] for s in mat.samples()]\\nerda = mat.values_by_sample(names, quantity=\\\"D_concentration\\\", method=\\\"ERDA\\\")\\nnra = mat.values_by_sample(names, quantity=\\\"D_concentration\\\", method=\\\"NRA\\\")\\nhe = mat.values_by_sample(names, quantity=\\\"He_concentration\\\", method=\\\"ERDA\\\")\\nprof = mat.profiles(names, quantity=\\\"D_concentration\\\", method=\\\"LAMS\\\")\\n\\ndef get(d, n):\\n    v = d.get(n)\\n    if v is None or isinstance(v, list):\\n        return None, None\\n    if not v[\\\"measured\\\"]:\\n        return None, None\\n    return v[\\\"value_num\\\"], v[\\\"value_std\\\"]\\n\\n# ---- Figure 1: ERDA D retention bar chart ----\\nfig, ax = plt.subplots(figsize=(14, 8))\\norder = [\\\"W-DH\\\", \\\"W-He600-DH\\\", \\\"W-He800-DH\\\", \\\"W-DL\\\", \\\"W-He600-DL\\\", \\\"W-He800-DL\\\"]\\nlabels = [\\\"H-mode\\\\nno He\\\", \\\"H-mode\\\\nHe 600 K\\\", \\\"H-mode\\\\nHe 800 K\\\",\\n          \\\"L-mode\\\\nno He\\\", \\\"L-mode\\\\nHe 600 K\\\", \\\"L-mode\\\\nHe 800 K\\\"]\\nvals = [get(erda, n)[0] / 1e15 for n in order]\\nstds = [get(erda, n)[1] / 1e15 for n in order]\\ncolors = [\\\"#1f78b4\\\", \\\"#a6cee3\\\", \\\"#33a02c\\\", \\\"#1f78b4\\\", \\\"#a6cee3\\\", \\\"#33a02c\\\"]\\nbars = ax.bar(range(6), vals, yerr=stds, capsize=5, color=colors, edgecolor=\\\"black\\\")\\nfor i, (v, s) in enumerate(zip(vals, stds)):\\n    ax.text(i, v + s + 0.05, \\\"%.2f\\\" % v, ha=\\\"center\\\", fontsize=11)\\nax.set_xticks(range(6))\\nax.set_xticklabels(labels, fontsize=11)\\nax.set_ylabel(\\\"D retention (10$^{15}$ atoms cm$^{-2}$)\\\", fontsize=12)\\nax.set_title(\\\"Deuterium retention in W after DIII-D exposure (ERDA, areal)\\\", fontsize=14)\\nax.set_ylim(0, 3.0)\\nax.grid(axis=\\\"y\\\", alpha=0.3)\\n# legend for He pre-exposure class\\nfrom matplotlib.patches import Patch\\nax.legend(handles=[Patch(color=\\\"#1f78b4\\\", label=\\\"no He pre-exposure\\\"),\\n                   Patch(color=\\\"#a6cee3\\\", label=\\\"He pre-exposure 600 K\\\"),\\n                   Patch(color=\\\"#33a02c\\\", label=\\\"He pre-exposure 800 K\\\")],\\n          loc=\\\"upper right\\\", fontsize=11)\\nplt.tight_layout()\\nprint(mat.save_figure(fig, \\\"erda_retention_bars.png\\\"))\\n\\n# ---- Figure 2: LAMS D depth profiles ----\\nfig, axes = plt.subplots(1, 2, figsize=(14, 8))\\ngroups = [(\\\"H-mode\\\", [\\\"W-DH\\\", \\\"W-He600-DH\\\", \\\"W-He800-DH\\\"], [\\\"#1f78b4\\\", \\\"#a6cee3\\\", \\\"#33a02c\\\"]),\\n          (\\\"L-mode\\\", [\\\"W-DL\\\", \\\"W-He600-DL\\\", \\\"W-He800-DL\\\"], [\\\"#1f78b4\\\", \\\"#a6cee3\\\", \\\"#33a02c\\\"])]\\nfor ax, (title, grp, cols) in zip(axes, groups):\\n    for n, c in zip(grp, cols):\\n        pts = prof[n]\\n        d = np.array([p[\\\"depth_um\\\"] for p in pts])\\n        v = np.array([p[\\\"value_num\\\"] for p in pts])\\n        s = np.array([p[\\\"value_std\\\"] for p in pts])\\n        ax.errorbar(d, v, yerr=s, fmt=\\\"o-\\\", color=c, label=n, capsize=3, markersize=4)\\n    ax.set_xscale(\\\"log\\\")\\n    ax.set_yscale(\\\"log\\\")\\n    ax.set_xlabel(\\\"Depth (µm)\\\", fontsize=12)\\n    ax.set_ylabel(\\\"D concentration (APPM)\\\", fontsize=12)\\n    ax.set_title(title + \\\" (LAMS depth profiles)\\\", fontsize=13)\\n    ax.legend(fontsize=10)\\n    ax.grid(alpha=0.3)\\nplt.tight_layout()\\nprint(mat.save_figure(fig, \\\"lams_depth_profiles.png\\\"))\\n\\n# ---- Figure 3: D retention vs He retention (ERDA) ----\\nfig, ax = plt.subplots(figsize=(14, 8))\\nhe_vals = [get(he, n)[0] / 1e15 for n in order]\\nd_vals = [get(erda, n)[0] / 1e15 for n in order]\\nhe_stds = [get(he, n)[1] / 1e15 for n in order]\\nd_stds = [get(erda, n)[1] / 1e15 for n in order]\\nax.errorbar(he_vals, d_vals, xerr=he_stds, yerr=d_stds, fmt=\\\"o\\\", capsize=4, color=\\\"#333333\\\", zorder=3)\\nfor i, n in enumerate(order):\\n    ax.annotate(n, (he_vals[i], d_vals[i]), textcoords=\\\"offset points\\\", xytext=(8, 6), fontsize=10)\\nax.set_xlabel(\\\"He retention (10$^{15}$ atoms cm$^{-2}$)\\\", fontsize=12)\\nax.set_ylabel(\\\"D retention (10$^{15}$ atoms cm$^{-2}$)\\\", fontsize=12)\\nax.set_title(\\\"D vs He retention after DIII-D exposure (ERDA)\\\", fontsize=14)\\nax.grid(alpha=0.3)\\nplt.tight_layout()\\nprint(mat.save_figure(fig, \\\"d_vs_he_scatter.png\\\"))\\n\\n# ---- Save NRA band data ----\\nrows = []\\nfor n in names:\\n    v = nra.get(n)\\n    if v is None:\\n        continue\\n    for e in v:\\n        rows.append({\\\"sample\\\": n, \\\"band\\\": e[\\\"qualifier\\\"], \\\"D_1e16_cm2\\\": e[\\\"value_num\\\"] / 1e16})\\nimport csv\\nwith open(os.path.join(mat.working_dir(), \\\"nra_bands.csv\\\"), \\\"w\\\", newline=\\\"\\\") as f:\\n    w = csv.DictWriter(f, fieldnames=[\\\"sample\\\", \\\"band\\\", \\\"D_1e16_cm2\\\"])\\n    w.writeheader()\\n    w.writerows(rows)\\nprint(\\\"WROTE nra_bands.csv\\\")\\n\",\n",
