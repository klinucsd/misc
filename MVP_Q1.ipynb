       "  \"content\": \"import sys, os\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-materials\\\"))\\nimport d3d_materials as mat\\nimport numpy as np\\n\\nnames = [s[\\\"name\\\"] for s in mat.samples()]\\nerda = mat.values_by_sample(names, quantity=\\\"D_concentration\\\", method=\\\"ERDA\\\")\\nnra = mat.values_by_sample(names, quantity=\\\"D_concentration\\\", method=\\\"NRA\\\")\\nhe = mat.values_by_sample(names, quantity=\\\"He_concentration\\\", method=\\\"ERDA\\\")\\nprof = mat.profiles(names, quantity=\\\"D_concentration\\\", method=\\\"LAMS\\\")\\n\\ndef get(d, n):\\n    v = d.get(n)\\n    if v is None or isinstance(v, list):\\n        return None, None\\n    if not v[\\\"measured\\\"]:\\n        return None, None\\n    return v[\\\"value_num\\\"], v[\\\"value_std\\\"]\\n\\n# Full table\\nprint(\\\"%-14s %-12s %-12s %-12s %-12s %-12s\\\" % (\\\"sample\\\", \\\"ERDA D\\\", \\\"ERDA D std\\\", \\\"NRA D tot\\\", \\\"LAMS int\\\", \\\"ERDA He\\\"))\\nfor n in names:\\n    ev, es = get(erda, n)\\n    hv, hs = get(he, n)\\n    nv = nra.get(n)\\n    ntot = sum(e[\\\"value_num\\\"] for e in nv) if nv else None\\n    lv = prof.get(n)\\n    lint = None\\n    if lv:\\n        d = np.array([p[\\\"depth_um\\\"] for p in lv])\\n        v = np.array([p[\\\"value_num\\\"] for p in lv])\\n        lint = np.trapz(v, d) * 6.3e22 * 1e-6 * 1e-4\\n    def fmt(x):\\n        return \\\"%.2e\\\" % x if x is not None else \\\"n/a\\\"\\n    print(\\\"%-14s %-12s %-12s %-12s %-12s %-12s\\\" % (n, fmt(ev), fmt(es), fmt(ntot), fmt(lint), fmt(hv)))\\n\\n# NRA surface vs subsurface fractions\\nprint(\\\"\\\\n=== NRA: subsurface fraction of total ===\\\")\\nfor n in names:\\n    nv = nra.get(n)\\n    if not nv:\\n        continue\\n    surf = [e[\\\"value_num\\\"] for e in nv if \\\"surface\\\" in e[\\\"qualifier\\\"]][0]\\n    sub = [e[\\\"value_num\\\"] for e in nv if \\\"sub\\\" in e[\\\"qualifier\\\"]][0]\\n    tot = surf + sub\\n    print(\\\"%-14s surf=%.2e sub=%.2e sub_frac=%.3f\\\" % (n, surf, sub, sub/tot if tot else 0))\\n\\n# He retention in He-only samples vs He+D samples\\nprint(\\\"\\\\n=== He retention: He-only vs He+D (ERDA) ===\\\")\\nfor n in [\\\"W-He600\\\", \\\"W-He800\\\", \\\"W-He600-DH\\\", \\\"W-He800-DH\\\", \\\"W-He600-DL\\\", \\\"W-He800-DL\\\"]:\\n    hv, hs = get(he, n)\\n    print(\\\"%-14s %.2e +/- %.2e\\\" % (n, hv, hs))\\n\",\n",
