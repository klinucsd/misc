       "  \"content\": \"import sys, os\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-materials\\\"))\\nimport d3d_materials as mat\\nimport numpy as np\\nfrom PIL import Image\\n\\n# All pre-characterization images for the three samples\\nimgs = mat.image_artifacts([\\\"W-pristine\\\", \\\"W-He600\\\", \\\"W-He800\\\"])\\nprint(\\\"dedup rows:\\\", len(imgs), \\\"| delivered files:\\\", sum(r[\\\"represents\\\"] for r in imgs))\\n\\n# Group by (CM_MAG, CM_ACCEL_VOLT)\\nby = {}\\nfor a in imgs:\\n    md = a[\\\"metadata\\\"] or {}\\n    key = (md.get(\\\"CM_MAG\\\"), md.get(\\\"CM_ACCEL_VOLT\\\"))\\n    if all(key):\\n        by.setdefault(key, {}).setdefault(a[\\\"sample_name\\\"], a)\\n\\nprint(\\\"\\\\n=== combinations (mag, kV) -&gt; n_samples ===\\\")\\nfor key, d in sorted(by.items(), key=lambda kv: (-len(kv[1]), -int(kv[0][0]))):\\n    print(key, len(d), sorted(d.keys()))\\n\\n# Pick: most samples, tie-break higher mag\\nbest = max(by.items(), key=lambda kv: (len(kv[1]), int(kv[0][0])))\\nprint(\\\"\\\\nBEST:\\\", best[0], \\\"-&gt;\\\", sorted(best[1].keys()))\\npick = list(best[1].values())\\n\\n# Load and measure: grayscale std (texture) and mean abs gradient\\nstats = {}\\nfor a in pick:\\n    img = mat.load_image(a[\\\"artifact_id\\\"]).convert(\\\"L\\\")\\n    arr = np.asarray(img, dtype=float)\\n    gx = np.abs(np.diff(arr, axis=1)).mean()\\n    gy = np.abs(np.diff(arr, axis=0)).mean()\\n    stats[a[\\\"sample_name\\\"]] = {\\\"std\\\": arr.std(), \\\"grad\\\": (gx + gy) / 2}\\n    print(a[\\\"sample_name\\\"], \\\"std=%.1f grad=%.2f\\\" % (arr.std(), (gx + gy) / 2))\\n\\n# Save the comparison figure\\nfig = mat.show_images([a[\\\"artifact_id\\\"] for a in pick],\\n                      labels=[a[\\\"sample_name\\\"] for a in pick],\\n                      title=\\\"W surface before DIII-D exposure (He pre-exposure effect)\\\")\\nref = mat.save_figure(fig, \\\"sem_pre_exposure.png\\\")\\nprint(\\\"\\\\nREF:\\\", ref)\\n\",\