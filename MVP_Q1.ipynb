     "data": {
      "text/html": [
       "\n",
       "<div style=\"background:#f5f7ff; border-left:3px solid #4a7fd4;\n",
       "            padding:5px 10px; margin:3px 0 12px 0; font-size:0.85em;\">\n",
       "  ✏️ <b>write_file</b> — Writing: <code>/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/_test_sage_/summary_figs.py</code>\n",
       "  <details>\n",
       "    <summary style=\"cursor:pointer; color:#888; font-size:0.9em;\">details</summary>\n",
       "    <div style=\"margin-top:4px; font-family:monospace; font-size:0.9em;\">\n",
       "      <pre style='margin:0'>{\n",
       "  \"content\": \"import sys, os, csv\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-materials\\\"))\\nimport d3d_materials as mat\\nimport numpy as np\\nimport matplotlib\\nmatplotlib.use(\\\"Agg\\\")\\nimport matplotlib.pyplot as plt\\n\\nnames = [s[\\\"name\\\"] for s in mat.samples()]\\nerda = mat.values_by_sample(names, quantity=\\\"D_concentration\\\", method=\\\"ERDA\\\")\\nnra = mat.values_by_sample(names, quantity=\\\"D_concentration\\\", method=\\\"NRA\\\")\\nhe = mat.values_by_sample(names, quantity=\\\"He_concentration\\\", method=\\\"ERDA\\\")\\nprof = mat.profiles(names, quantity=\\\"D_concentration\\\", method=\\\"LAMS\\\")\\n\\ndef get(d, n):\\n    v = d.get(n)\\n    if v is None or isinstance(v, list):\\n        return None, None\\n    if not v[\\\"measured\\\"]:\\n        return None, None\\n    return v[\\\"value_num\\\"], v[\\\"value_std\\\"]\\n\\ndef nra_total(n):\\n    v = nra.get(n)\\n    return sum(e[\\\"value_num\\\"] for e in v) if v else None\\n\\ndef lams_int(n):\\n    pts = prof.get(n)\\n    if not pts:\\n        return None\\n    d = np.array([p[\\\"depth_um\\\"] for p in pts])\\n    v = np.array([p[\\\"value_num\\\"] for p in pts])\\n    return np.trapz(v, d) * 6.3e22 * 1e-6 * 1e-4\\n\\n# ---- Ratio table: He-pre / no-He, per method, per mode ----\\npairs = [(\\\"H-mode\\\", \\\"W-DH\\\", \\\"W-He600-DH\\\", \\\"W-He800-DH\\\"),\\n         (\\\"L-mode\\\", \\\"W-DL\\\", \\\"W-He600-DL\\\", \\\"W-He800-DL\\\")]\\nmethods = [(\\\"ERDA\\\", lambda n: get(erda, n)[0], lambda n: get(erda, n)[1]),\\n           (\\\"NRA\\\", nra_total, lambda n: None),\\n           (\\\"LAMS\\\", lams_int, lambda n: None)]\\n\\nrows = []\\nfor mode, ctrl, h6, h8 in pairs:\\n    for mname, valf, stdf in methods:\\n        c = valf(ctrl)\\n        for label, h in [(\\\"He600\\\", h6), (\\\"He800\\\", h8)]:\\n            hv = valf(h)\\n            if c is None or hv is None or c == 0:\\n                continue\\n            ratio = hv / c\\n            cs = stdf(ctrl); hs = stdf(h)\\n            if cs is not None and hs is not None:\\n                err = ratio * np.sqrt((hs / hv) ** 2 + (cs / c) ** 2)\\n            else:\\n                err = None\\n            rows.append({\\\"mode\\\": mode, \\\"method\\\": mname, \\\"he_pre\\\": label,\\n                         \\\"ratio\\\": ratio, \\\"ratio_std\\\": err,\\n                         \\\"he_val\\\": hv, \\\"ctrl_val\\\": c})\\n            print(\\\"%-6s %-5s %-6s ratio=%.3f +/- %.3f\\\" % (mode, mname, label, ratio, err if err else float(\\\"nan\\\")))\\n\\n# ---- Figure: ratio by method and mode ----\\nfig, axes = plt.subplots(1, 2, figsize=(14, 8), sharey=True)\\ncolors = {\\\"He600\\\": \\\"#a6cee3\\\", \\\"He800\\\": \\\"#33a02c\\\"}\\nfor ax, (mode, ctrl, h6, h8) in zip(axes, pairs):\\n    x = np.arange(3)\\n    for i, (label, h) in enumerate([(\\\"He600\\\", h6), (\\\"He800\\\", h8)]):\\n        vals = []\\n        errs = []\\n        for mname, valf, stdf in methods:\\n            c = valf(ctrl); hv = valf(h)\\n            if c is None or hv is None or c == 0:\\n                vals.append(np.nan); errs.append(np.nan); continue\\n            r = hv / c\\n            cs = stdf(ctrl); hs = stdf(h)\\n            e = r * np.sqrt((hs / hv) ** 2 + (cs / c) ** 2) if (cs is not None and hs is not None) else None\\n            vals.append(r); errs.append(e)\\n        vals = np.array(vals, dtype=float)\\n        errs = np.array([e if e is not None else 0.0 for e in errs], dtype=float)\\n        ax.bar(x + (i - 0.5) * 0.35, vals, yerr=errs, width=0.32, capsize=4,\\n               color=colors[label], edgecolor=\\\"black\\\", label=\\\"He pre-exposure \\\" + label)\\n    ax.axhline(1.0, color=\\\"red\\\", ls=\\\"--\\\", lw=1.5, label=\\\"no-He control\\\")\\n    ax.set_xticks(x)\\n    ax.set_xticklabels([\\\"ERDA\\\", \\\"NRA\\\", \\\"LAMS\\\"], fontsize=12)\\n    ax.set_title(mode + \\\" DIII-D exposure\\\", fontsize=13)\\n    ax.set_ylabel(\\\"D retention ratio (He-pre / no-He)\\\", fontsize=12)\\n    ax.grid(axis=\\\"y\\\", alpha=0.3)\\n    ax.legend(fontsize=10)\\n    ax.set_ylim(0, 2.2)\\nplt.tight_layout()\\nprint(mat.save_figure(fig, \\\"he_effect_ratios.png\\\"))\\n\\n# ---- Figure: NRA surface vs subsurface ----\\nfig, ax = plt.subplots(figsize=(14, 8))\\norder = [\\\"W-DH\\\", \\\"W-He600-DH\\\", \\\"W-He800-DH\\\", \\\"W-DL\\\", \\\"W-He600-DL\\\", \\\"W-He800-DL\\\"]\\nlabels = [\\\"H no He\\\", \\\"H He600\\\", \\\"H He800\\\", \\\"L no He\\\", \\\"L He600\\\", \\\"L He800\\\"]\\nsurf = []; sub = []\\nfor n in order:\\n    v = nra.get(n)\\n    s = [e[\\\"value_num\\\"] for e in v if \\\"surface\\\" in e[\\\"qualifier\\\"]][0] / 1e15\\n    b = [e[\\\"value_num\\\"] for e in v if \\\"sub\\\" in e[\\\"qualifier\\\"]][0] / 1e15\\n    surf.append(s); sub.append(b)\\nx = np.arange(6)\\nax.bar(x, surf, color=\\\"#1f78b4\\\", edgecolor=\\\"black\\\", label=\\\"surface 0-0.5 µm\\\")\\nax.bar(x, sub, bottom=surf, color=\\\"#a6cee3\\\", edgecolor=\\\"black\\\", label=\\\"sub-surface 0.5-3 µm\\\")\\nfor i, (s, b) in enumerate(zip(surf, sub)):\\n    ax.text(i, s + b + 0.05, \\\"%.2f\\\" % (s + b), ha=\\\"center\\\", fontsize=10)\\nax.set_xticks(x)\\nax.set_xticklabels(labels, fontsize=11)\\nax.set_ylabel(\\\"D retention (10$^{15}$ atoms cm$^{-2}$)\\\", fontsize=12)\\nax.set_title(\\\"NRA deuterium retention by depth band\\\", fontsize=14)\\nax.legend(fontsize=11)\\nax.grid(axis=\\\"y\\\", alpha=0.3)\\nplt.tight_layout()\\nprint(mat.save_figure(fig, \\\"nra_bands.png\\\"))\\n\\n# ---- Save comprehensive CSV ----\\nwith open(os.path.join(mat.working_dir(), \\\"retention_summary.csv\\\"), \\\"w\\\", newline=\\\"\\\") as f:\\n    w = csv.writer(f)\\n    w.writerow([\\\"sample\\\", \\\"mode\\\", \\\"he_pre\\\", \\\"erda_D_1e15_cm2\\\", \\\"erda_D_std_1e15_cm2\\\",\\n                \\\"nra_D_total_1e15_cm2\\\", \\\"lams_D_integrated_1e15_cm2\\\", \\\"erda_He_1e15_cm2\\\", \\\"erda_He_std_1e15_cm2\\\"])\\n    for n in names:\\n        ev, es = get(erda, n)\\n        hv, hs = get(he, n)\\n        mode = \\\"H\\\" if n.endswith(\\\"DH\\\") else (\\\"L\\\" if n.endswith(\\\"DL\\\") else \\\"-\\\")\\n        hep = \\\"600\\\" if \\\"He600\\\" in n else (\\\"800\\\" if \\\"He800\\\" in n else \\\"none\\\")\\n        nt = nra_total(n)\\n        li = lams_int(n)\\n        w.writerow([n, mode, hep,\\n                    \\\"%.4g\\\" % (ev / 1e15) if ev is not None else \\\"\\\",\\n                    \\\"%.4g\\\" % (es / 1e15) if es is not None else \\\"\\\",\\n                    \\\"%.4g\\\" % (nt / 1e15) if nt is not None else \\\"\\\",\\n                    \\\"%.4g\\\" % (li / 1e15) if li is not None else \\\"\\\",\\n                    \\\"%.4g\\\" % (hv / 1e15) if hv is not None else \\\"\\\",\\n                    \\\"%.4g\\\" % (hs / 1e15) if hs is not None else \\\"\\\"])\\nprint(\\\"WROTE retention_summary.csv\\\")\\n\\n# ---- Save ratio CSV ----\\nwith open(os.path.join(mat.working_dir(), \\\"he_effect_ratios.csv\\\"), \\\"w\\\", newline=\\\"\\\") as f:\\n    w = csv.DictWriter(f, fieldnames=[\\\"mode\\\", \\\"method\\\", \\\"he_pre\\\", \\\"ratio\\\", \\\"ratio_std\\\", \\\"he_val\\\", \\\"ctrl_val\\\"])\\n    w.writeheader()\\n    for r in rows:\\n        w.writerow({k: (\\\"%.4f\\\" % v if isinstance(v, float) else v) for k, v in r.items()})\\nprint(\\\"WROTE he_effect_ratios.csv\\\")\\n\",\n",
