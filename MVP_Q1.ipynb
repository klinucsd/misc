       "    <div style=\"margin-top:4px; font-family:monospace; font-size:0.9em;\">\n",
       "      <pre style='margin:0'>{\n",
       "  \"content\": \"import sys, os, json\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-materials\\\"))\\nimport d3d_materials as mat\\nimport numpy as np\\n\\nnames = [s[\\\"name\\\"] for s in mat.samples()]\\n\\n# ERDA areal D retention (atoms cm^-2)\\nerda = mat.values_by_sample(names, quantity=\\\"D_concentration\\\", method=\\\"ERDA\\\")\\n# NRA areal D retention, two depth bands\\nnra = mat.values_by_sample(names, quantity=\\\"D_concentration\\\", method=\\\"NRA\\\")\\n# ERDA He areal\\nhe = mat.values_by_sample(names, quantity=\\\"He_concentration\\\", method=\\\"ERDA\\\")\\n\\ndef get(d, n):\\n    v = d.get(n)\\n    if v is None:\\n        return None, None\\n    if isinstance(v, list):\\n        return None, None\\n    if not v[\\\"measured\\\"]:\\n        return None, None\\n    return v[\\\"value_num\\\"], v[\\\"value_std\\\"]\\n\\nprint(\\\"=== ERDA D retention (atoms cm^-2) ===\\\")\\nfor n in names:\\n    val, std = get(erda, n)\\n    print(\\\"%-14s %s +/- %s\\\" % (n, val, std))\\n\\nprint(\\\"\\\\n=== NRA D retention by band (atoms cm^-2) ===\\\")\\nfor n in names:\\n    v = nra.get(n)\\n    if v is None:\\n        print(n, \\\"none\\\")\\n        continue\\n    for e in v:\\n        print(\\\"%-14s %-22s %s\\\" % (n, e[\\\"qualifier\\\"], e[\\\"value_num\\\"]))\\n\\nprint(\\\"\\\\n=== ERDA He retention (atoms cm^-2) ===\\\")\\nfor n in names:\\n    val, std = get(he, n)\\n    print(\\\"%-14s %s +/- %s\\\" % (n, val, std))\\n\\n# Ratios: He-pre-exposed vs no-He, within same DIII-D mode\\nprint(\\\"\\\\n=== RATIOS (He-pre / no-He) ===\\\")\\npairs = [(\\\"W-DH\\\", \\\"W-He600-DH\\\", \\\"H-mode, He600\\\"),\\n         (\\\"W-DH\\\", \\\"W-He800-DH\\\", \\\"H-mode, He800\\\"),\\n         (\\\"W-DL\\\", \\\"W-He600-DL\\\", \\\"L-mode, He600\\\"),\\n         (\\\"W-DL\\\", \\\"W-He800-DL\\\", \\\"L-mode, He800\\\")]\\nfor ctrl, he_s, label in pairs:\\n    cv, cs = get(erda, ctrl)\\n    hv, hs = get(erda, he_s)\\n    if cv and hv:\\n        r = hv / cv\\n        # propagate relative errors\\n        rel = np.sqrt((cs/cv)**2 + (hs/hv)**2)\\n        print(\\\"%-22s ERDA ratio = %.3f +/- %.3f  (He %.2e, ctrl %.2e)\\\" % (label, r, r*rel, hv, cv))\\n\\n# NRA total (surface + subsurface)\\nprint(\\\"\\\\n=== NRA total (surface + sub) ===\\\")\\ntot = {}\\nfor n in names:\\n    v = nra.get(n)\\n    if v is None:\\n        continue\\n    s = sum(e[\\\"value_num\\\"] for e in v)\\n    tot[n] = s\\n    print(\\\"%-14s %.3e\\\" % (n, s))\\n\\nprint(\\\"\\\\n=== NRA ratios (He-pre / no-He) ===\\\")\\nfor ctrl, he_s, label in pairs:\\n    if ctrl in tot and he_s in tot:\\n        print(\\\"%-22s NRA ratio = %.3f\\\" % (label, tot[he_s]/tot[ctrl]))\\n\\n# LAMS depth profiles: integrate D APPM over depth to areal density\\n# APPM = atoms per million W atoms. W atomic density = 6.3e22 atoms/cm3\\nW_ATOMS = 6.3e22  # atoms/cm3\\nprint(\\\"\\\\n=== LAMS D integrated (atoms cm^-2) ===\\\")\\nprof = mat.profiles(names, quantity=\\\"D_concentration\\\", method=\\\"LAMS\\\")\\nlams_int = {}\\nfor n, pts in prof.items():\\n    d = np.array([p[\\\"depth_um\\\"] for p in pts])\\n    v = np.array([p[\\\"value_num\\\"] for p in pts])\\n    # integrate APPM * W density over depth: APPM * 6.3e22 * (depth in cm)\\n    # depth um -&gt; cm: *1e-4\\n    integ = np.trapz(v, d) * W_ATOMS * 1e-4  # APPM*cm * atoms/cm3 = atoms/cm2\\n    lams_int[n] = integ\\n    print(\\\"%-14s %.3e atoms cm^-2\\\" % (n, integ))\\n\\nprint(\\\"\\\\n=== LAMS ratios (He-pre / no-He) ===\\\")\\nfor ctrl, he_s, label in pairs:\\n    if ctrl in lams_int and he_s in lams_int:\\n        print(\\\"%-22s LAMS ratio = %.3f\\\" % (label, lams_int[he_s]/lams_int[ctrl]))\\n\\n# Save a tidy CSV\\nrows = []\\nfor n in names:\\n    ev, es = get(erda, n)\\n    hv, hs = get(he, n)\\n    rows.append({\\\"sample\\\": n,\\n                 \\\"erda_D_1e16_cm2\\\": None if ev is None else ev/1e16,\\n                 \\\"erda_D_std_1e16_cm2\\\": None if es is None else es/1e16,\\n                 \\\"erda_He_1e16_cm2\\\": None if hv is None else hv/1e16,\\n                 \\\"erda_He_std_1e16_cm2\\\": None if hs is None else hs/1e16,\\n                 \\\"nra_D_total_1e16_cm2\\\": tot.get(n),\\n                 \\\"lams_D_integrated_1e16_cm2\\\": lams_int.get(n)})\\nimport csv\\nwith open(os.path.join(mat.working_dir(), \\\"retention_summary.csv\\\"), \\\"w\\\", newline=\\\"\\\") as f:\\n    w = csv.DictWriter(f, fieldnames=list(rows[0].keys()))\\n    w.writeheader()\\n    w.writerows(rows)\\nprint(\\\"\\\\nWROTE retention_summary.csv\\\")\\n\",\n",
