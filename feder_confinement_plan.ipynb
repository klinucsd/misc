orks)\\n        out[\\\"works\\\"] = works\\n    except Exception as exc:  # noqa: BLE001\\n        out[\\\"scope_error\\\"] = f\\\"{type(exc).__name__}: {exc}\\\"\\n    try:\\n        allw = lit.works()\\n        out[\\\"n_works_all\\\"] = len(allw)\\n        out[\\\"works_all\\\"] = allw\\n    except Exception as exc:  # noqa: BLE001\\n        out[\\\"works_all_error\\\"] = f\\\"{type(exc).__name__}: {exc}\\\"\\nexcept Exception as exc:  # noqa: BLE001\\n    out[\\\"lit_error\\\"] = f\\\"{type(exc).__name__}: {exc}\\\"\\n\\npath = os.path.join(WORKDIR, \\\"probe_disruption_literature.json\\\")\\nwith open(path, \\\"w\\\") as fh:\\n    json.dump(out, fh, indent=2, default=str)\\n\\nprint(\\\"=== disruption index ===\\\")\\nif \\\"index_info\\\" in out:\\n    ii = out[\\\"index_info\\\"]\\n    print(\\\"shots:\\\", ii.get(\\\"n_shots\\\"), \\\"range\\\", ii.get(\\\"shot_min\\\"), \\\"-\\\", ii.get(\\\"shot_max\\\"))\\n    print(\\\"params:\\\", out[\\\"n_params\\\"])\\n    print(\\\"\\\\ndensity-like params:\\\", [p.get(\\\"name\\\") for p in out[\\\"density_like_params\\\"]])\\n    for name, info in out[\\\"density_param_info\\\"].items():\\n        print(f\\\"  {name}: {info}\\\")\\nelse:\\n    print(out.get(\\\"disruption_error\\\"))\\n\\nprint(\\\"\\\\n=== literature ===\\\")\\nprint(\\\"works in materials scope:\\\", out.get(\\\"n_works\\\"), out.get(\\\"scope_error\\\", \\\"\\\"))\\nfor w in (out.get(\\\"works\\\") or [])[:20]:\\n    print(\\\"  \\\", w)\\nprint(\\\"works with no scope:\\\", out.get(\\\"n_works_all\\\"), out.get(\\\"works_all_error\\\", \\\"\\\"))\\nfor w in (out.get(\\\"works_all\\\") or [])[:20]:\\n    print(\\\"  \\\", w)\\n\\nprint(\\\"\\\\nwrote\\\", path)\\n\",\n",
