       "\n",
       "<div style=\"background:#f5f7ff; border-left:3px solid #4a7fd4;\n",
       "            padding:5px 10px; margin:3px 0 12px 0; font-size:0.85em;\">\n",
       "  ✏️ <b>write_file</b> — Writing: <code>/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_/feasibility_d3d_confinement_density.py</code>\n",
       "  <details>\n",
       "    <summary style=\"cursor:pointer; color:#888; font-size:0.9em;\">details</summary>\n",
       "    <div style=\"margin-top:4px; font-family:monospace; font-size:0.9em;\">\n",
       "      <pre style='margin:0'>{\n",
       "  \"content\": \"r\\\"\\\"\\\"Feasibility: can we get tau_E (d3d tree) and time-resolved density + W + Greenwald fraction together?\\\"\\\"\\\"\\nimport os\\nimport sys\\nimport json\\nimport numpy as np\\n\\nWORKDIR = \\\"/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_\\\"\\nSHOT = 194000\\n\\nout = {\\\"shot\\\": SHOT}\\n\\n# ---- 1. confinement time from the d3d master tree (per the fetch skill) ----\\nfrom toksearch import Pipeline, MdsSignal  # noqa: E402\\n\\npipe = Pipeline([SHOT])\\npipe.fetch(\\\"taue\\\", MdsSignal(r\\\"\\\\taue\\\", \\\"d3d\\\"))\\npipe.fetch(\\\"wmhd\\\", MdsSignal(r\\\"\\\\wmhd\\\", \\\"efit01\\\"))\\npipe.fetch(\\\"q95\\\", MdsSignal(r\\\"\\\\q95\\\", \\\"efit01\\\"))\\npipe.fetch(\\\"betan\\\", MdsSignal(r\\\"\\\\betan\\\", \\\"efit01\\\"))\\n\\nrecs = pipe.compute_serial()\\nout[\\\"n_records\\\"] = len(recs)\\nif recs:\\n    rec = recs[0]\\n    out[\\\"errors\\\"] = {k: str(v) for k, v in dict(rec.errors).items()} if rec.errors else {}\\n    for name in (\\\"taue\\\", \\\"wmhd\\\", \\\"q95\\\", \\\"betan\\\"):\\n        try:\\n            sig = rec[name]\\n            d = np.asarray(sig[\\\"data\\\"], float)\\n            t = np.asarray(sig[\\\"times\\\"], float)\\n            out[name] = {\\n                \\\"n\\\": int(d.size),\\n                \\\"t_min\\\": float(t.min()), \\\"t_max\\\": float(t.max()),\\n                \\\"min\\\": float(np.nanmin(d)), \\\"max\\\": float(np.nanmax(d)),\\n                \\\"units\\\": sig[\\\"units\\\"][\\\"data\\\"],\\n            }\\n        except Exception as exc:  # noqa: BLE001\\n            out[name] = f\\\"ERROR {type(exc).__name__}: {exc}\\\"\\n\\n# ---- 2. time-resolved density + Greenwald fraction from the disruption index ----\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-disruption\\\"))\\ntry:\\n    from d3d_disruption import fetch_samples, is_indexed  # noqa: E402\\n    out[\\\"indexed\\\"] = bool(is_indexed(SHOT))\\n    if out[\\\"indexed\\\"]:\\n        rows = fetch_samples(SHOT, [\\\"n_e\\\", \\\"greenwald_fraction\\\", \\\"wmhd\\\", \\\"q95\\\", \\\"beta_n\\\", \\\"ip\\\"])\\n        out[\\\"n_rows\\\"] = len(rows)\\n        out[\\\"row0\\\"] = rows[0] if rows else None\\n        for col in (\\\"n_e\\\", \\\"greenwald_fraction\\\", \\\"wmhd\\\", \\\"q95\\\", \\\"beta_n\\\", \\\"ip\\\"):\\n            vals = [r[col] for r in rows if r.get(col) is not None]\\n            out[f\\\"fill_{col}\\\"] = f\\\"{len(vals)}/{len(rows)}\\\"\\n            if vals:\\n                out[f\\\"range_{col}\\\"] = [float(min(vals)), float(max(vals))]\\nexcept Exception as exc:  # noqa: BLE001\\n    out[\\\"index_error\\\"] = f\\\"{type(exc).__name__}: {exc}\\\"\\n\\npath = os.path.join(WORKDIR, \\\"feasibility_d3d_confinement_density.json\\\")\\nwith open(path, \\\"w\\\") as fh:\\n    json.dump(out, fh, indent=2, default=str)\\n\\nprint(\\\"=== DIII-D feasibility, shot\\\", SHOT, \\\"===\\\")\\nprint(\\\"records:\\\", out.get(\\\"n_records\\\"), \\\"errors:\\\", out.get(\\\"errors\\\"))\\nfor name in (\\\"taue\\\", \\\"wmhd\\\", \\\"q95\\\", \\\"betan\\\"):\\n    print(f\\\"  {name}: {out.get(name)}\\\")\\nprint(\\\"\\\\nindexed:\\\", out.get(\\\"indexed\\\"), out.get(\\\"index_error\\\", \\\"\\\"))\\nprint(\\\"index rows:\\\", out.get(\\\"n_rows\\\"))\\nfor col in (\\\"n_e\\\", \\\"greenwald_fraction\\\", \\\"wmhd\\\", \\\"q95\\\", \\\"beta_n\\\", \\\"ip\\\"):\\n    print(f\\\"  {col:20s} fill={out.get(f'fill_{col}')} range={out.get(f'range_{col}')}\\\")\\nprint(\\\"\\\\nwrote\\\", path)\\n\",\n",
       "  \"file_path\": \"/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_/feasibility_d3d_confinement_density.py\"\n",
