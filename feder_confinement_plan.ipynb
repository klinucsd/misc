       "  ✏️ <b>write_file</b> — Writing: <code>/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_/probe_survey_viability.py</code>\n",
       "  <details>\n",
       "    <summary style=\"cursor:pointer; color:#888; font-size:0.9em;\">details</summary>\n",
       "    <div style=\"margin-top:4px; font-family:monospace; font-size:0.9em;\">\n",
       "      <pre style='margin:0'>{\n",
       "  \"content\": \"r\\\"\\\"\\\"Is a broad DIII-D density-vs-confinement survey viable? Count shots with ALL inputs for\\nGreenwald fraction and IPB98(y,2) H-factor jointly populated.\\\"\\\"\\\"\\nimport os\\nimport sys\\nimport json\\n\\nWORKDIR = \\\"/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_\\\"\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-relational-db\\\"))\\nfrom d3d_relational_db import query_d3drdb  # noqa: E402\\n\\nout = {}\\n\\n# Joint coverage: Greenwald inputs (ip, a, density) + scaling inputs (btor, r, kappa, powers)\\nq = \\\"\\\"\\\"\\nSELECT\\n  COUNT(*) AS n_total,\\n  SUM(CASE WHEN ip IS NOT NULL AND a IS NOT NULL AND density_avg IS NOT NULL\\n           THEN 1 ELSE 0 END) AS n_greenwald_avg,\\n  SUM(CASE WHEN ip IS NOT NULL AND a IS NOT NULL AND nemax_thomson IS NOT NULL\\n           THEN 1 ELSE 0 END) AS n_greenwald_peak,\\n  SUM(CASE WHEN ip IS NOT NULL AND a IS NOT NULL AND density_avg IS NOT NULL\\n                AND btor IS NOT NULL AND r IS NOT NULL AND kappa IS NOT NULL\\n                AND wtotmax IS NOT NULL AND poh IS NOT NULL\\n           THEN 1 ELSE 0 END) AS n_tauE_core,\\n  SUM(CASE WHEN ip IS NOT NULL AND a IS NOT NULL AND density_avg IS NOT NULL\\n                AND btor IS NOT NULL AND r IS NOT NULL AND kappa IS NOT NULL\\n                AND wtotmax IS NOT NULL AND poh IS NOT NULL AND pbeam IS NOT NULL\\n           THEN 1 ELSE 0 END) AS n_tauE_with_beam,\\n  SUM(CASE WHEN ip IS NOT NULL AND a IS NOT NULL AND density_avg IS NOT NULL\\n                AND btor IS NOT NULL AND r IS NOT NULL AND kappa IS NOT NULL\\n                AND wtotmax IS NOT NULL AND poh IS NOT NULL AND pbeam IS NOT NULL\\n                AND prad IS NOT NULL\\n           THEN 1 ELSE 0 END) AS n_tauE_with_rad,\\n  SUM(CASE WHEN pulse_length IS NOT NULL AND ip_flat IS NOT NULL\\n           THEN 1 ELSE 0 END) AS n_flattop\\nFROM SUMMARIES\\n\\\"\\\"\\\"\\nout[\\\"joint_coverage\\\"] = query_d3drdb(q)\\n\\n# How many shots have a long flattop (proxy for \\\"sustained\\\")?\\nq2 = \\\"\\\"\\\"\\nSELECT COUNT(*) AS n FROM SUMMARIES\\nWHERE ip_flat_duration IS NOT NULL AND ip_flat_duration &gt; 1.0\\n\\\"\\\"\\\"\\nout[\\\"n_flattop_gt1s\\\"] = query_d3drdb(q2)\\n\\nq3 = \\\"\\\"\\\"\\nSELECT COUNT(*) AS n FROM SUMMARIES\\nWHERE ip_flat_duration IS NOT NULL AND ip_flat_duration &gt; 2.0\\n\\\"\\\"\\\"\\nout[\\\"n_flattop_gt2s\\\"] = query_d3drdb(q3)\\n\\n# Distribution of density_avg to see the dynamic range available\\nq4 = \\\"\\\"\\\"\\nSELECT\\n  MIN(density_avg) AS min_dens,\\n  MAX(density_avg) AS max_dens,\\n  AVG(density_avg) AS avg_dens\\nFROM SUMMARIES WHERE density_avg IS NOT NULL\\n\\\"\\\"\\\"\\nout[\\\"density_range\\\"] = query_d3drdb(q4)\\n\\n# Shot-number span, so the plan can state the era covered\\nq5 = \\\"SELECT MIN(shot) AS lo, MAX(shot) AS hi FROM SUMMARIES\\\"\\nout[\\\"shot_span\\\"] = query_d3drdb(q5)\\n\\npath = os.path.join(WORKDIR, \\\"probe_survey_viability.json\\\")\\nwith open(path, \\\"w\\\") as fh:\\n    json.dump(out, fh, indent=2, default=str)\\n\\nprint(\\\"=== joint coverage ===\\\")\\nfor row in out[\\\"joint_coverage\\\"]:\\n    for k, v in row.items():\\n        print(f\\\"  {k:22s} {v}\\\")\\nprint(\\\"\\\\nflattop &gt; 1.0 s:\\\", out[\\\"n_flattop_gt1s\\\"])\\nprint(\\\"flattop &gt; 2.0 s:\\\", out[\\\"n_flattop_gt2s\\\"])\\nprint(\\\"\\\\ndensity_avg range:\\\", out[\\\"density_range\\\"])\\nprint(\\\"shot span:\\\", out[\\\"shot_span\\\"])\\nprint(\\\"\\\\nwrote\\\", path)\\n\",\n",
       "  \"file_path\": \"/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_/probe_survey_viability.py\"\n",
