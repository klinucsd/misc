()), 3),\\n                \\\"t_min\\\": float(np.nanmin(t)) if t.size else None,\\n                \\\"t_max\\\": float(np.nanmax(t)) if t.size else None,\\n                \\\"min\\\": float(np.nanmin(d)) if fin.any() else None,\\n                \\\"max\\\": float(np.nanmax(d)) if fin.any() else None,\\n                \\\"units\\\": sig[\\\"units\\\"][\\\"data\\\"],\\n            }\\n        except Exception as exc:  # noqa: BLE001\\n            info[name] = f\\\"ERROR {type(exc).__name__}: {exc}\\\"\\n    out[\\\"per_shot\\\"][shot] = info\\n\\npath = os.path.join(WORKDIR, \\\"feasibility_mast_confinement_density.json\\\")\\nwith open(path, \\\"w\\\") as fh:\\n    json.dump(out, fh, indent=2, default=str)\\n\\nprint(\\\"=== MAST feasibility ===\\\")\\nprint(\\\"records:\\\", out[\\\"n_records\\\"])\\nfor shot, info in out[\\\"per_shot\\\"].items():\\n    print(f\\\"\\\\n--- shot {shot} ---\\\")\\n    print(\\\"  errors:\\\", info[\\\"errors\\\"])\\n    for name in paths:\\n        v = info[name]\\n        if isinstance(v, str):\\n            print(f\\\"  {name:8s} {v}\\\")\\n        else:\\n            print(f\\\"  {name:8s} n={v['n']:5d} finite={v['finite']:5d} \\\"\\n                  f\\\"cov={v['coverage']:.2f} t={v['t_min']}..{v['t_max']} \\\"\\n                  f\\\"range={v['min']}..{v['max']} [{v['units']}]\\\")\\n\\nprint(\\\"\\\\nwrote\\\", path)\\n\",\n",
