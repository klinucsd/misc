      "text/html": [
       "\n",
       "<div style=\"background:#f5f7ff; border-left:3px solid #4a7fd4;\n",
       "            padding:5px 10px; margin:3px 0 12px 0; font-size:0.85em;\">\n",
       "  ✏️ <b>write_file</b> — Writing: <code>/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_/probe_d3d_density_confinement.py</code>\n",
       "  <details>\n",
       "    <summary style=\"cursor:pointer; color:#888; font-size:0.9em;\">details</summary>\n",
       "    <div style=\"margin-top:4px; font-family:monospace; font-size:0.9em;\">\n",
       "      <pre style='margin:0'>{\n",
       "  \"file_path\": \"/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_/probe_d3d_density_confinement.py\",\n",
       "  \"content\": \"r\\\"\\\"\\\"Inventory DIII-D shot-summary and signal-catalog coverage for density + confinement.\\\"\\\"\\\"\\nimport os\\nimport sys\\nimport json\\n\\nWORKDIR = \\\"/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_\\\"\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-relational-db\\\"))\\nfrom d3d_relational_db import query_d3drdb, search_signal_catalog  # noqa: E402\\n\\nout = {}\\n\\n# ---- 1. every SUMMARIES column, and how many rows actually carry a value ----\\nrow = query_d3drdb(\\\"SELECT * FROM SUMMARIES LIMIT 1\\\")[0]\\nnames = list(row.keys())\\nout[\\\"n_summaries_columns\\\"] = len(names)\\nout[\\\"summaries_columns\\\"] = names\\n\\ntotal = query_d3drdb(\\\"SELECT COUNT(*) AS n FROM SUMMARIES\\\")[0][\\\"n\\\"]\\nout[\\\"n_summary_rows\\\"] = total\\n\\ncandidates = [\\n    \\\"nemax_co2\\\", \\\"t_nemax_co2\\\", \\\"nemax_thomson\\\", \\\"density_avg\\\",\\n    \\\"temax_ece\\\", \\\"temax_thomson\\\",\\n    \\\"wtotmax\\\", \\\"t_wtotmax\\\", \\\"betanmax\\\", \\\"t_betanmax\\\",\\n    \\\"ip\\\", \\\"ipmax\\\", \\\"ip_flat\\\", \\\"ip_flat_duration\\\", \\\"btor\\\", \\\"a\\\", \\\"r\\\",\\n    \\\"kappa\\\", \\\"pbeam\\\", \\\"prad\\\", \\\"poh\\\", \\\"pech\\\", \\\"pulse_length\\\",\\n    \\\"gas\\\", \\\"zeff\\\", \\\"neutrons\\\", \\\"fbs\\\", \\\"t_efit\\\",\\n]\\npresent = [c for c in candidates if c in names]\\nmissing = [c for c in candidates if c not in names]\\nout[\\\"candidate_columns_present\\\"] = present\\nout[\\\"candidate_columns_missing\\\"] = missing\\n\\nsel = \\\", \\\".join(f\\\"COUNT({c}) AS {c}\\\" for c in present)\\nfill = query_d3drdb(f\\\"SELECT {sel} FROM SUMMARIES\\\")[0]\\nout[\\\"fill_counts\\\"] = {c: fill[c] for c in present}\\n\\n# ---- 2. does the signal catalog know the confinement / density tags? ----\\nsearches = [\\\"taue\\\", \\\"tauel89\\\", \\\"tau\\\", \\\"confinement\\\", \\\"nemax\\\", \\\"density\\\",\\n            \\\"greenwald\\\", \\\"ne\\\", \\\"dalpha\\\", \\\"line_average\\\"]\\nout[\\\"catalog\\\"] = {}\\nfor term in searches:\\n    try:\\n        rows = search_signal_catalog(term)\\n    except Exception as exc:  # noqa: BLE001\\n        out[\\\"catalog\\\"][term] = f\\\"ERROR: {exc}\\\"\\n        continue\\n    out[\\\"catalog\\\"][term] = [\\n        {\\\"Name\\\": r.get(\\\"Name\\\"), \\\"Tree\\\": r.get(\\\"Tree\\\"),\\n         \\\"Description\\\": r.get(\\\"Description\\\"), \\\"Units\\\": r.get(\\\"Units\\\")}\\n        for r in rows[:12]\\n    ]\\n\\npath = os.path.join(WORKDIR, \\\"probe_d3d_density_confinement.json\\\")\\nwith open(path, \\\"w\\\") as fh:\\n    json.dump(out, fh, indent=2, default=str)\\n\\nprint(\\\"=== SUMMARIES:\\\", out[\\\"n_summaries_columns\\\"], \\\"columns,\\\", total, \\\"rows ===\\\")\\nprint(\\\"\\\\n--- fill counts (non-null rows) ---\\\")\\nfor c in present:\\n    print(f\\\"  {c:22s} {fill[c]:6d} / {total}\\\")\\nif missing:\\n    print(\\\"\\\\n  NOT COLUMNS:\\\", missing)\\n\\nprint(\\\"\\\\n--- catalog hits ---\\\")\\nfor term, rows in out[\\\"catalog\\\"].items():\\n    if isinstance(rows, str):\\n        print(f\\\"\\\\n[{term}] {rows}\\\")\\n        continue\\n    print(f\\\"\\\\n[{term}] {len(rows)} row(s)\\\")\\n    for r in rows:\\n        print(f\\\"   {r['Name']:22s} tree={str(r['Tree']):14s} \\\"\\n              f\\\"{str(r['Description'])[:60]:60s} {r['Units']}\\\")\\n\\nprint(\\\"\\\\nwrote\\\", path)\\n\"\n",
       "}</pre>\n",
