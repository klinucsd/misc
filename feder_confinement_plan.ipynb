       "      <pre style='margin:0'>{\n",
       "  \"content\": \"r\\\"\\\"\\\"Probe: which DIII-D density signal is usable, and how well do confinement signals cover shots?\\\"\\\"\\\"\\nimport os\\nimport sys\\nimport json\\nimport numpy as np\\n\\nWORKDIR = \\\"/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_sage_\\\"\\nout = {}\\n\\nsys.path.insert(0, os.path.expanduser(\\\"~/.deepagents/agent/skills/d3d-shot-fetcher\\\"))\\ntry:\\n    from d3d_ptdata import find_signals  # noqa: E402\\n    for pat in (\\\"DENSV%\\\", \\\"DENSR%\\\", \\\"TAUE%\\\", \\\"H98%\\\", \\\"H_%\\\", \\\"TAUEL%\\\", \\\"PBEAM%\\\", \\\"PRAD%\\\", \\\"AMINOR%\\\", \\\"BETAN%\\\"):\\n        try:\\n            rows = find_signals(pat, limit=60)\\n            out[f\\\"find_{pat}\\\"] = [\\n                {\\\"name\\\": r.get(\\\"name\\\"), \\\"tree\\\": r.get(\\\"tree\\\")} for r in rows\\n            ]\\n        except Exception as exc:  # noqa: BLE001\\n            out[f\\\"find_{pat}\\\"] = f\\\"ERROR {type(exc).__name__}: {exc}\\\"\\nexcept Exception as exc:  # noqa: BLE001\\n    out[\\\"find_error\\\"] = f\\\"{type(exc).__name__}: {exc}\\\"\\n\\n# ---- fetch candidate density + power + confinement signals across shots ----\\nfrom toksearch import Pipeline, MdsSignal  # noqa: E402\\n\\nSHOTS = [165340, 165920, 188702, 194000]\\n\\ncandidates = {\\n    \\\"densv2\\\": (r\\\"\\\\densv2\\\", \\\"efit01\\\"),\\n    \\\"densr0\\\": (r\\\"\\\\densr0\\\", \\\"efit01\\\"),\\n    \\\"ipmhd\\\": (r\\\"\\\\ipmhd\\\", \\\"efit01\\\"),\\n    \\\"aminor\\\": (r\\\"\\\\aminor\\\", \\\"efit01\\\"),\\n    \\\"wmhd\\\": (r\\\"\\\\wmhd\\\", \\\"efit01\\\"),\\n    \\\"pbeam\\\": (r\\\"\\\\pbeam\\\", \\\"efit01\\\"),\\n    \\\"poh\\\": (r\\\"\\\\poh\\\", \\\"efit01\\\"),\\n    \\\"prad\\\": (r\\\"\\\\prad\\\", \\\"efit01\\\"),\\n    \\\"q95\\\": (r\\\"\\\\q95\\\", \\\"efit01\\\"),\\n    \\\"betan\\\": (r\\\"\\\\betan\\\", \\\"efit01\\\"),\\n    \\\"taue\\\": (r\\\"\\\\taue\\\", \\\"d3d\\\"),\\n    \\\"tauel89\\\": (r\\\"\\\\tauel89\\\", \\\"d3d\\\"),\\n}\\n\\npipe = Pipeline(SHOTS)\\nfor name, (expr, tree) in candidates.items():\\n    pipe.fetch(name, MdsSignal(expr, tree))\\n\\nrecs = pipe.compute_serial()\\nout[\\\"n_records\\\"] = len(recs)\\nout[\\\"per_shot\\\"] = {}\\n\\nfor rec in recs:\\n    shot = rec[\\\"shot\\\"]\\n    info = {\\\"errors\\\": sorted(dict(rec.errors).keys()) if rec.errors else []}\\n    for name in candidates:\\n        try:\\n            sig = rec[name]\\n            if sig is None:\\n                info[name] = \\\"NONE\\\"\\n                continue\\n            d = np.asarray(sig[\\\"data\\\"], float)\\n            t = np.asarray(sig[\\\"times\\\"], float)\\n            fin = np.isfinite(d)\\n            info[name] = {\\n                \\\"n\\\": int(d.size),\\n                \\\"finite\\\": int(fin.sum()),\\n                \\\"t0\\\": round(float(np.nanmin(t)), 1) if t.size else None,\\n                \\\"t1\\\": round(float(np.nanmax(t)), 1) if t.size else None,\\n                \\\"min\\\": float(np.nanmin(d)) if fin.any() else None,\\n                \\\"max\\\": float(np.nanmax(d)) if fin.any() else None,\\n                \\\"units\\\": sig[\\\"units\\\"][\\\"data\\\"],\\n            }\\n        except Exception as exc:  # noqa: BLE001\\n            info[name] = f\\\"ERR {type(exc).__name__}\\\"\\n    out[\\\"per_shot\\\"][shot] = info\\n\\npath = os.path.join(WORKDIR, \\\"probe_d3d_density_signal.json\\\")\\nwith open(path, \\\"w\\\") as fh:\\n    json.dump(out, fh, indent=2, default=str)\\n\\nprint(\\\"=== find_signals ===\\\")\\nfor k, v in out.items():\\n    if not k.startswith(\\\"find_\\\"):\\n        continue\\n    print(f\\\"\\\\n{k}:\\\")\\n    if isinstance(v, str):\\n        print(\\\"  \\\", v)\\n        continue\\n    for r in v[:25]:\\n        print(f\\\"   {r['name']:20s} tree={r['tree']}\\\")\\n\\nprint(\\\"\\\\n=== per-shot coverage ===\\\")\\nfor shot, info in out[\\\"per_shot\\\"].items():\\n    print(f\\\"\\\\n--- shot {shot} --- errors: {info['errors']}\\\")\\n    for name in candidates:\\n        v = info[name]\\n        if isinstance(v, str):\\n            print(f\\\"  {name:9s} {v}\\\")\\n        else:\\n            print(f\\\"  {name:9s} n={v['n']:5d} fin={v['finite']:5d} \\\"\\n                  f\\\"t={v['t0']}..{v['t1']} range={v['min']}..{v['max']} [{v['units']}]\\\")\\n\\nprint(\\\"\\\\nwrote\\\", path)\\n\",\n",
