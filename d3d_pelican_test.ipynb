       "  \"content\": \"r\\\"\\\"\\\"Fetch \\\\ipmhd from efit01 for shot 165340, plot vs time, report sample count and min/max.\\\"\\\"\\\"\\nimport os\\nimport json\\n\\nimport numpy as np\\nimport matplotlib\\nmatplotlib.use(\\\"Agg\\\")\\nimport matplotlib.pyplot as plt\\n\\nfrom toksearch import Pipeline, MdsSignal\\n\\nWORKDIR = \\\"/home/jovyan/work/_User-Persistent-Storage_CephBlock_/deep_tok/fdp-demo/_d3d_pelican_test_sage_\\\"\\nSHOT = 165340\\n\\n\\ndef main():\\n    pipe = Pipeline([SHOT])\\n    pipe.fetch(\\\"ip\\\", MdsSignal(r\\\"\\\\ipmhd\\\", \\\"efit01\\\"))\\n    results = pipe.compute_serial()\\n\\n    print(\\\"records returned:\\\", len(results))\\n    for rec in results:\\n        print(\\\"shot\\\", rec[\\\"shot\\\"], \\\"errors:\\\", rec.errors)\\n\\n    rec = results[0]\\n    sig = rec[\\\"ip\\\"]\\n    data = np.asarray(sig[\\\"data\\\"], float)\\n    times = np.asarray(sig[\\\"times\\\"], float)\\n    units = sig[\\\"units\\\"][\\\"data\\\"]\\n\\n    n = int(data.size)\\n    t_min, t_max = float(times.min()), float(times.max())\\n    dt = float(np.median(np.diff(times))) if n &gt; 1 else float(\\\"nan\\\")\\n    rate_hz = 1000.0 / dt if dt and np.isfinite(dt) else float(\\\"nan\\\")\\n\\n    i_min, i_max = float(data.min()), float(data.max())\\n    t_at_min = float(times[int(np.argmin(data))])\\n    t_at_max = float(times[int(np.argmax(data))])\\n\\n    print(f\\\"units={units!r}  n={n}  t={t_min:.1f}..{t_max:.1f} ms  dt={dt:.3f} ms ({rate_hz:.2f} Hz)\\\")\\n    print(f\\\"min={i_min:.6e} {units} at t={t_at_min:.1f} ms\\\")\\n    print(f\\\"max={i_max:.6e} {units} at t={t_at_max:.1f} ms\\\")\\n\\n    # ---- save the trace ----\\n    csv_path = os.path.join(WORKDIR, \\\"ipmhd_165340.csv\\\")\\n    np.savetxt(\\n        csv_path,\\n        np.column_stack([times, data]),\\n        delimiter=\\\",\\\",\\n        header=f\\\"time_ms,ipmhd_{units}\\\",\\n        comments=\\\"\\\",\\n        fmt=\\\"%.6f,%.6e\\\",\\n    )\\n\\n    stats = {\\n        \\\"shot\\\": SHOT,\\n        \\\"signal\\\": r\\\"\\\\ipmhd\\\",\\n        \\\"tree\\\": \\\"efit01\\\",\\n        \\\"units\\\": units,\\n        \\\"n_samples\\\": n,\\n        \\\"t_start_ms\\\": t_min,\\n        \\\"t_end_ms\\\": t_max,\\n        \\\"median_dt_ms\\\": dt,\\n        \\\"sample_rate_hz\\\": rate_hz,\\n        \\\"min_value\\\": i_min,\\n        \\\"min_value_MA\\\": i_min / 1e6,\\n        \\\"t_at_min_ms\\\": t_at_min,\\n        \\\"max_value\\\": i_max,\\n        \\\"max_value_MA\\\": i_max / 1e6,\\n        \\\"t_at_max_ms\\\": t_at_max,\\n        \\\"mean_value\\\": float(data.mean()),\\n        \\\"median_value\\\": float(np.median(data)),\\n    }\\n    json_path = os.path.join(WORKDIR, \\\"ipmhd_165340_stats.json\\\")\\n    with open(json_path, \\\"w\\\") as fh:\\n        json.dump(stats, fh, indent=2)\\n\\n    # ---- plot ----\\n    ip_ma = data / 1e6\\n    fig, ax = plt.subplots(figsize=(14, 8), dpi=150)\\n    ax.plot(times, ip_ma, color=\\\"#1f4e79\\\", lw=1.6, label=\\\"efit01 ipmhd\\\")\\n\\n    ax.axhline(0.0, color=\\\"grey\\\", lw=0.8, ls=\\\":\\\")\\n\\n    ax.plot([t_at_max], [i_max / 1e6], \\\"o\\\", color=\\\"#b30000\\\", ms=8, zorder=5)\\n    ax.annotate(\\n        f\\\"max {i_max/1e6:.3f} MA\\\\nat {t_at_max:.0f} ms\\\",\\n        xy=(t_at_max, i_max / 1e6),\\n        xytext=(12, -34),\\n        textcoords=\\\"offset points\\\",\\n        fontsize=11,\\n        color=\\\"#b30000\\\",\\n        arrowprops=dict(arrowstyle=\\\"-&gt;\\\", color=\\\"#b30000\\\", lw=1.2),\\n    )\\n    ax.plot([t_at_min], [i_min / 1e6], \\\"o\\\", color=\\\"#006837\\\", ms=8, zorder=5)\\n    ax.annotate(\\n        f\\\"min {i_min/1e6:.3f} MA\\\\nat {t_at_min:.0f} ms\\\",\\n        xy=(t_at_min, i_min / 1e6),\\n        xytext=(14, 26),\\n        textcoords=\\\"offset points\\\",\\n        fontsize=11,\\n        color=\\\"#006837\\\",\\n        arrowprops=dict(arrowstyle=\\\"-&gt;\\\", color=\\\"#006837\\\", lw=1.2),\\n    )\\n\\n    ax.set_xlabel(\\\"Time (ms)\\\", fontsize=13)\\n    ax.set_ylabel(\\\"Plasma current (MA)\\\", fontsize=13)\\n    ax.set_title(\\n        f\\\"DIII-D shot {SHOT}: efit01 ipmhd (plasma current), {n} samples\\\",\\n        fontsize=15,\\n    )\\n    ax.grid(alpha=0.3)\\n    ax.legend(loc=\\\"upper left\\\", fontsize=11)\\n    ax.tick_params(labelsize=11)\\n    fig.tight_layout()\\n\\n    png_path = os.path.join(WORKDIR, \\\"ipmhd_165340.png\\\")\\n    fig.savefig(png_path, dpi=150)\\n    plt.close(fig)\\n\\n    print(\\\"wrote:\\\", csv_path)\\n    print(\\\"wrote:\\\", json_path)\\n    print(\\\"wrote:\\\", png_path)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"\n",
