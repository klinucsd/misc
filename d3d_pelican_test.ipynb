nt()\\nfor k in sorted(by_hist, key=lambda k: -by_hist[k]):\\n    print(\\\"%-26s %d\\\" % (k, by_hist[k]))\\nprint()\\nfor s in samples:\\n    print(\\\"%-14s %-26s %s\\\" % (s[\\\"name\\\"], s[\\\"exposure_history\\\"], s[\\\"exposures\\\"] or \\\"-\\\"))\\n\\n# ---- CSV ----\\ncsv_path = os.path.join(OUT, \\\"tungsten_samples.csv\\\")\\nwith open(csv_path, \\\"w\\\", newline=\\\"\\\") as f:\\n    w = csv.DictWriter(f, fieldnames=[\\\"name\\\", \\\"material\\\", \\\"ordinal\\\", \\\"exposure_history\\\",\\n                                      \\\"exposures\\\", \\\"description\\\", \\\"investigator\\\", \\\"delivery_id\\\"])\\n    w.writeheader()\\n    w.writerows(samples)\\nprint(\\\"\\\\nwrote\\\", csv_path)\\n\\n# ---- JSON summary ----\\nsummary = {\\n    \\\"question\\\": \\\"How many tungsten samples are in the materials delivery?\\\",\\n    \\\"n_samples_total\\\": n_total,\\n    \\\"n_tungsten_samples\\\": n_W,\\n    \\\"materials_present\\\": sorted({s[\\\"material\\\"] for s in samples}),\\n    \\\"n_deliveries\\\": len({s[\\\"delivery_id\\\"] for s in samples}),\\n    \\\"delivery_ids\\\": sorted({s[\\\"delivery_id\\\"] for s in samples}),\\n    \\\"by_exposure_history\\\": by_hist,\\n    \\\"sample_names\\\": [s[\\\"name\\\"] for s in samples],\\n    \\\"ontology_term\\\": {\\\"our_term\\\": \\\"W\\\", \\\"community_label\\\": \\\"tungsten\\\",\\n                      \\\"match\\\": \\\"exact\\\",\\n                      \\\"iri\\\": \\\"https://w3id.org/feder/ontology/v4/common-materials#Tungsten\\\"},\\n    \\\"source\\\": \\\"materials.samples via d3d_lakehouse.query; exposures via mat.exposures()\\\",\\n}\\njson_path = os.path.join(OUT, \\\"tungsten_sample_count.json\\\")\\nwith open(json_path, \\\"w\\\") as f:\\n    json.dump(summary, f, indent=2)\\nprint(\\\"wrote\\\", json_path)\\n\\n# ---- figure: samples by exposure history ----\\norder = [\\\"Pristine (no exposure)\\\", \\\"PISCES-A only\\\", \\\"DIII-D only\\\", \\\"PISCES-A then DIII-D\\\"